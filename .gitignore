.DS_Store
.claude/
__pycache__/
/lattice-control
/lattice-gateway
/lattice-frontend
/lattice-cli
/lattice-stats
# Binaries left behind when `go build ./cmd/...` is run from the repo root.
/cmd/*/lattice-control
/cmd/*/lattice-gateway
/cmd/*/lattice-frontend
*.jsonl
*.py
# Deployment artifacts are Python but must ship: the mflux image-gen sidecar and
# the Hermes image_gen plugin are the repo's source of truth (see the spec).
!deploy/mflux-sidecar.py
!deploy/esrgan-sidecar.py
!deploy/hermes/plugins/image_gen/mflux/__init__.py
!deploy/dsh/mcp-imagegen/server.py
!deploy/dsh/mcp-imagegen/test_server.py
!deploy/dsh/mcp-imagegen/test_stdio.py
/bin/
/deploy/*.env
