# Copy to ~/.config/lattice/lattice-modelrepo.env on the Pi and adjust.
# Placeholders only — no usernames, hostnames, or real addresses live in the
# repo (invariant 8).

# Loopback for this host's own work; add the host's tailscale address for the
# gateways to reach it (comma-separate binds like the frontend).
LATTICE_MODELREPO_BIND=127.0.0.1:8090

# The big partition holding the blob store. The service manages only its
# inference-repo/blob-llm subtree under this root.
LATTICE_MODELREPO_STORE=<big-volume-mount>

# Telemetry plane file (JSONL, one request_id per op).
LATTICE_MODELREPO_TELEMETRY=/var/log/lattice/telemetry-modelrepo.jsonl