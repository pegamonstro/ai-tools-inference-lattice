# Lattice control plane — environment.
#
# Copy to %h/.config/lattice/lattice-control.env and fill in the real address.
# The real file is gitignored: it holds host-specific values that must not be
# committed. Every variable here is optional except LATTICE_LOCAL_GATEWAYS,
# whose default (localhost) is wrong on the Pi.

# The local gateways the control plane polls, as id=endpoint pairs. Each entry
# is polled on /health and its announced models/slots/context folded into the
# registry; routing sends a model to whichever gateway announces it. List every
# Mac that computes local inference.
LATTICE_LOCAL_GATEWAYS=m1-gateway=http://<m1-tailnet-address>:8081,m6-gateway=http://<m6-tailnet-address>:8081

# Single-gateway fallback: when LATTICE_LOCAL_GATEWAYS is unset, the plane
# registers one "mac-gateway" from this value.
#LATTICE_GATEWAY_URL=http://<mac-tailnet-address>:8081

# Where the cloud Ollama runs. The default is correct when cloud models are
# served by the Ollama instance on this same host.
#LATTICE_OLLAMA_URL=http://127.0.0.1:11434

# Listen address for /route and /status.
#LATTICE_CONTROL_ADDR=:8082

# Relay file for gateway telemetry pulled over HTTP (written by this process).
#LATTICE_GATEWAY_TELEMETRY_LOCAL=/var/log/lattice/telemetry-gateway.jsonl
