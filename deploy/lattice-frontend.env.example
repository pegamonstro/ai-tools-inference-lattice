# Lattice frontend — environment.
#
# Copy to %h/.config/lattice/lattice-frontend.env. The real file is gitignored.
# The defaults are correct for the standard single-host layout, so this file is
# mostly a place to record deviations.

# The control plane's decision endpoint. Default is right when the control plane
# runs on the same host as the frontend.
#LATTICE_CONTROL_URL=http://127.0.0.1:8082/route

# The public listen address.
#LATTICE_FRONTEND_ADDR=:8080

# Where completion telemetry is appended. Must match the path the Bee feeder
# tails, or events silently never reach the display.
#LATTICE_FRONTEND_TELEMETRY=/var/log/lattice/telemetry-frontend.jsonl
